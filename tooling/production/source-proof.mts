import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import { unzipSync } from 'fflate';
import { digest, json } from './source.mts';
import { provenance } from './evidence.mts';

const version = (JSON.parse(readFileSync('package.json', 'utf8')) as { version: string }).version;
const path = `dist/Elvorance-Enterprise-${version}.zip`;
const archive = readFileSync(path);
const contents = unzipSync(archive);
const tree = execFileSync('git', ['ls-tree', '-r', '-z', 'HEAD'], { encoding: 'utf8' })
  .split('\0')
  .filter(Boolean);
// This existing tracked file is regenerated by parity. Its two hashes remain explicit.
const generated = new Set(['tests/design-parity/artifacts/latest-results.json']);
const failures: string[] = [];
const entries: {
  path: string;
  sourceBlob: string;
  packagedBlob: string | null;
  canonicalBlob: string | null;
  sha256: string | null;
  disposition: string;
}[] = [];
for (const entry of tree) {
  const match = /^(\d+) blob ([a-f0-9]{40})\t(.+)$/.exec(entry);
  if (!match) {
    failures.push(`Unsupported source tree entry: ${entry}`);
    continue;
  }
  const [, , expected, sourcePath] = match;
  const bytes = contents[`Elvorance-Enterprise/${sourcePath}`];
  const blob = bytes
    ? createHash('sha1').update(`blob ${bytes.length}\0`).update(bytes).digest('hex')
    : null;
  // Git's declared text/eol attributes may convert tracked .bat files to CRLF on checkout.
  // Compare the canonical Git blob as well as retaining the actual packaged-byte digest.
  const canonical = bytes
    ? execFileSync('git', ['hash-object', `--path=${sourcePath}`, '--stdin'], {
        input: bytes,
        encoding: 'utf8',
      }).trim()
    : null;
  const disposition =
    blob === expected
      ? 'exact-source-bytes'
      : canonical === expected
        ? 'attribute-normalized-source-bytes'
        : generated.has(sourcePath!) && bytes
          ? 'declared-generated-report'
          : 'BLOCKED';
  if (disposition === 'BLOCKED') failures.push(`Source archive drift/missing: ${sourcePath}`);
  entries.push({
    path: sourcePath!,
    sourceBlob: expected!,
    packagedBlob: blob,
    canonicalBlob: canonical,
    sha256: bytes ? digest(bytes) : null,
    disposition,
  });
}
const report = {
  schemaVersion: 1,
  ...provenance(),
  archive: { path, sha256: digest(archive), bytes: archive.length },
  status: failures.length ? 'BLOCKED' : 'PASS',
  failures,
  scope:
    'Tracked source bytes/canonical declared Git attributes checked against Git blobs; packaging may normalize executable modes. Preview HTML and one regenerated parity report are review outputs, not original Git blobs.',
  entries,
};
writeFileSync('dist/source-proof.json', json(report));
console.log(json({ status: report.status, files: entries.length, failures }));
if (failures.length) process.exitCode = 1;
