{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/service.Dockerfile",
    "watchPatterns": [
      "services/**",
      "packages/**",
      "tooling/scripts/build-services.mts",
      "package*.json",
      "infra/docker/**"
    ]
  },
  "deploy": {
    "preDeployCommand": "/usr/local/bin/atlas-entrypoint --migrate-only",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
