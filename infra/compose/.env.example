# Copy to infra/compose/.env and run the documented init-env.mts helper.
# This file intentionally contains no working credentials.
COMPOSE_PROJECT_NAME=atlas-enterprise
IMAGE_TAG=local
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=postgres:16-bookworm
RABBITMQ_IMAGE=rabbitmq:4-management
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=3000
RABBITMQ_MANAGEMENT_BIND_HOST=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_VALUE
IDENTITY_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
CRM_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
SALES_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
DELIVERY_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
BILLING_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
TRACKING_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
COMMUNICATIONS_DB_PASSWORD=REPLACE_WITH_GENERATED_VALUE
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=REPLACE_WITH_GENERATED_VALUE
DEV_JWT_SECRET=REPLACE_WITH_GENERATED_VALUE
# Development only: service-kit rejects dev-hs256 when NODE_ENV=production.
AUTH_MODE=dev-hs256
OIDC_ISSUER=https://atlas.local.invalid
OIDC_AUDIENCE=atlas-enterprise
OIDC_JWKS_URL=
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://localhost,capacitor://localhost
