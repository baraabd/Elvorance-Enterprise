# Frontend preview deliberately uses browser-local synthetic data.
ATLAS_DATA_MODE=demo
# For the typed API client / production feature adapters. Do not put secrets in frontend config.
ATLAS_API_BASE_URL=http://localhost:3000
# OIDC configuration belongs to each service; copy infra/compose/.env.example for local backend.
# Native devices need an HTTPS address reachable from the device, not localhost.

