{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/backend/**/*.ts",
    "apps/*/src/main.ts",
    "apps/*/config.example.ts",
    "infra/compose/init-env.mts",
    "examples/instant-close/build.mts",
    "tooling/scripts/audit-migration.mts",
    "tooling/scripts/copy-content.mts",
    "packages/contracts/src/browser-window.d.ts",
    "tooling/scripts/workspace.mts",
    "tooling/scripts/dev.mts",
    "apps/rep-mobile/src/server/**/*.ts",
    "apps/rep-mobile/src/server-main.ts",
    "tooling/scripts/rep-release/**/*.mts",
    "tooling/scripts/build-rep-server.mts",
    "tooling/scripts/rep-native/**/*.mts",
    "infra/identity/**/*.mts",
    "infra/environments/**/*.mts",
    "tests/runtime/**/*.mts",
    "tests/identity/**/*.mts",
    "tooling/scripts/test-local-identity.mts",
    "tooling/production/**/*.mts",
    "tests/production/**/*.mts",
    "tests/acceptance/**/*.mts",
    "tooling/scripts/run-acceptance.mts",
    "tooling/qa/**/*.mts",
    "tests/ux/**/*.ts",
    "tests/ux/**/*.mts",
    "apps/admin-web/src/server/**/*.ts",
    "apps/admin-web/src/server-main.ts",
    "tests/admin/**/*.mts",
    "tooling/scripts/build-admin-server.mts",
    "tests/admin/**/*.ts",
    "tooling/scripts/sprint01-inventory.mts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/android", "**/ios"]
}
