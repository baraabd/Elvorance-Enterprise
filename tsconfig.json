{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/backend/**/*.ts",
    "apps/*/src/main.ts",
    "apps/*/config.example.ts",
    "infra/compose/init-env.mts",
    "examples/instant-close/build.mts",
    "tooling/scripts/audit-migration.mts",
    "tooling/scripts/copy-content.mts",
    "packages/contracts/src/browser-window.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/android",
    "**/ios"
  ]
}
